{
  "name": "@wabot-dev/framework",
  "version": "0.0.8",
  "description": "Framework for IA Chat Bots",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin typescript && tsup --dts-only --format esm --out-dir dist/src src/index.ts",
    "test:units": "node --import @yucacodes/ts/src/custom-import.mjs  --test './src/**/*.unit.test.ts'",
    "test:integration": "node --import @yucacodes/ts/src/custom-import.mjs  --test './src/**/*.integration.test.ts'",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "types:check": "tsc --noEmit",
    "elia:cmd": "node --import @yucacodes/ts/src/custom-import.mjs  ./test/elia/runEliaCmd.ts",
    "elia:telegram": "node --import @yucacodes/ts/src/custom-import.mjs  ./test/elia/runEliaTelegram.ts"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.2",
    "@types/node": "22.14.1",
    "@types/react": "^19.1.2",
    "@yucacodes/ts": "^0.0.4",
    "prettier": "^3.5.3",
    "resend": "^4.4.1",
    "rollup": "4.39.0",
    "tsup": "^8.4.0",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "grammy": "^1.36.0",
    "openai": "^4.93.0",
    "reflect-metadata": "^0.2.2",
    "sqlite": "^5.1.1",
    "sqlite3": "npm:sqlite3-offline-next@^5.0.3",
    "sqlite3-offline-next": "^5.0.3",
    "tslib": "^2.8.1",
    "tsyringe": "^4.9.1",
    "uuid": "^11.1.0",
    "@yucacodes/ts": "^0.0.4"
  }
}
