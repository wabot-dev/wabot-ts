{
  "name": "@wabot-dev/framework",
  "version": "1.0.0-beta.1",
  "description": "Framework for IA Chat Bots",
  "type": "module",
  "main": "dist/src/index.js",
  "module": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "wabot-skills": "./bin/wabot-skills.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "import": "./dist/src/testing/index.js"
    },
    "./ui": {
      "types": "./dist/src/ui/index.d.ts",
      "browser": "./dist/src/ui/client.js",
      "import": "./dist/src/ui/index.js"
    },
    "./ui/jsx-runtime": {
      "types": "./dist/src/ui/jsx-runtime.d.ts",
      "import": "./dist/src/ui/jsx-runtime.js"
    },
    "./ui/jsx-dev-runtime": {
      "types": "./dist/src/ui/jsx-dev-runtime.d.ts",
      "import": "./dist/src/ui/jsx-dev-runtime.js"
    },
    "./monitor": {
      "types": "./dist/src/addon/monitor/index.d.ts",
      "import": "./dist/src/addon/monitor/index.js"
    },
    "./ui/css-loader": {
      "import": "./dist/src/ui/cssModuleLoader.js"
    },
    "./ui/css-runtime": {
      "import": "./dist/src/ui/cssRegistry.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wabot-dev/wabot-ts"
  },
  "homepage": "https://docs.wabot.dev",
  "keywords": [
    "chatbot",
    "ai",
    "llm",
    "typescript",
    "framework",
    "telegram",
    "whatsapp",
    "wasender",
    "socket.io",
    "openai",
    "gpt",
    "anthropic",
    "claude",
    "google-genai",
    "gemini",
    "openrouter",
    "rest-api",
    "dependency-injection",
    "async-jobs",
    "cron",
    "messaging-platforms",
    "slack",
    "bot-framework",
    "conversational-ai"
  ],
  "files": [
    "dist/src",
    "dist/build",
    "bin",
    "skills",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin typescript",
    "test:units": "node --import @yucacodes/ts  --test './src/**/*.unit.test.ts'",
    "test:integration": "node --import @yucacodes/ts --import ./env.mjs  --test './src/**/*.integration.test.ts'",
    "test:multiprocess": "node --import @yucacodes/ts --import ./env.mjs  --test './src/**/*.multiprocess.test.ts'",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-commonjs": "28.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.2",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.1.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@slack/bolt": "^3.17.0",
    "@google/genai": "^1.16.0",
    "@openrouter/sdk": "^0.12.2",
    "@preact/signals": "^2.9.2",
    "@types/big.js": "^6.2.2",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.14.1",
    "@types/pg": "^8.11.14",
    "@yucacodes/ts": "^0.1.0",
    "big.js": "^7.0.1",
    "body-parser": "^2.2.0",
    "cron-parser": "^5.4.0",
    "debug": "^4.4.0",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.12",
    "express": "^5.1.0",
    "grammy": "^1.36.0",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.10.0",
    "pg": "^8.15.6",
    "preact": "^10.29.3",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "short-uuid": "^6.0.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.0",
    "tslib": "^2.8.1",
    "@hubspot/api-client": "^13.5.0",
    "tsyringe": "^4.9.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "wasenderapi": "^0.1.5"
  }
}
